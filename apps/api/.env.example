# WareFlow API — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is git-ignored.

# App
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Supabase / Postgres
DATABASE_URL=your_supabase_pooler_connection_string_here
DIRECT_DATABASE_URL=your_supabase_direct_connection_string_here
SUPABASE_URL=https://yappumzftkltlybmztgg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Firebase (server-side — Admin SDK)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=path/to/your/firebase-service-account.json

# Resend (email alerts)
RESEND_API_KEY=your_resend_api_key_here

# Groq (AI features)
GROQ_API_KEY=your_groq_api_key_here

# Security & 2FA (TOTP secret encryption key at rest)
TOTP_ENCRYPTION_KEY=your_32_byte_base64_or_hex_encryption_key_here

# GST Compliance & E-Invoicing (Step 10.3)
EINVOICE_ENABLED=false
GSP_PROVIDER=sandbox
GSP_API_KEY=your_gsp_api_key_here
GSP_API_SECRET=your_gsp_api_secret_here
EWAY_BILL_THRESHOLD_INR=50000.0

# WhatsApp (Meta Cloud API — Step 13.3)
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id_here

# SMS Provider (Fallback & Critical Alerts — Step 13.6)
SMS_PROVIDER=twilio
SMS_PROVIDER_API_KEY=your_sms_provider_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+15005550006

# Demand Forecasting (Step 14.1)
FORECAST_STRATEGY=moving_average
FORECAST_CACHE_TTL_HOURS=24


