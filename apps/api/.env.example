# WareFlow API — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is git-ignored.

# App
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000

# Supabase / Postgres
DATABASE_URL=your_supabase_pooler_connection_string_here
DIRECT_DATABASE_URL=your_supabase_direct_connection_string_here
SUPABASE_URL=https://yappumzftkltlybmztgg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Firebase (server-side — Admin SDK)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=path/to/your/firebase-service-account.json

# Resend (email alerts)
RESEND_API_KEY=your_resend_api_key_here

# Groq (AI features)
GROQ_API_KEY=your_groq_api_key_here
